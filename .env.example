# Cloudflare Tunnel Token
# Cloudflare Zero Trust Dashboard > Networks > Tunnels > Create Tunnel
# Token'ı buraya yapıştırın
TUNNEL_TOKEN=

# Tunnel hostname (opsiyonel, CORS ayarları için)
# Örn: coronary.yourdomain.com
TUNNEL_HOSTNAME=

# JWT Authentication
# Güçlü bir secret key oluşturun: openssl rand -hex 32
JWT_SECRET=

# Resend Email Service
# https://resend.com/api-keys adresinden API key alın
RESEND_API_KEY=
EMAIL_FROM=noreply@rwsanalyser.com
APP_URL=https://your-domain.com
